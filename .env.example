# Copy to .env.local for local development, or .env for docker compose.

# Required. Points at the TimescaleDB instance.
DATABASE_URL=postgres://mendly:mendly@localhost:5432/mendly
# Set to true for a managed instance that terminates TLS with its own CA.
DATABASE_SSL=false

# Required in production. Signs the session cookie.
SESSION_SECRET=change-me-in-production

# The LLM service. Backboard fronts the model and holds the planner's
# conversation and memory per patient, so Mendly stores no AI memory of its own
# beyond the thread id. Without a key, exercise sets are drafted by the local
# rules engine instead, which is deterministic and needs no network.
BACKBOARD_API_KEY=
# Which model Backboard routes to. Run `npm run ai:models` to list what this
# account can actually reach before changing these.
BACKBOARD_LLM_PROVIDER=google
BACKBOARD_MODEL=gemini-2.5-flash
# "Auto" lets Backboard remember this patient across sessions. "off" disables
# that, at the cost of the planner starting cold every time.
BACKBOARD_MEMORY=Auto
BACKBOARD_TIMEOUT_MS=30000
# Only for a different Backboard deployment. Leave this alone otherwise.
# BACKBOARD_API_URL=https://app.backboard.io/api/threads/messages

# Optional. Without a key, spoken prompts use the browser's own speech
# synthesis, so the app is still usable hands-free, with a plainer voice.
ELEVENLABS_API_KEY=
# Keep a value here under docker compose: it passes this through even when it
# is empty, and an empty voice id is not the same as an unset one.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Read by docker compose only; these do nothing under `npm run dev`.
# Change the host ports if something already uses them — a Postgres installed
# on the machine will usually be holding 5432. Compose builds DATABASE_URL from
# POSTGRES_PASSWORD, so change that rather than DATABASE_URL.
DB_PORT=5432
APP_PORT=3000
POSTGRES_PASSWORD=mendly
